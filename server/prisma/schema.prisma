generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAJER
  ASISTEN_MANAJER
  SUPERVISOR
  STAFF
}

enum AccountStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum ScheduleType {
  INTERNAL
  TAMU
}

enum ScheduleCategory {
  PRIBADI
  UNIT
  BERSAMA
}

enum ScheduleStatus {
  PENDING
  APPROVED
  REJECTED
  RESCHEDULED
}

enum RealizationStatus {
  BELUM_DIISI
  SESUAI
  TIDAK_SESUAI
}

// Tipe pengajuan perubahan jadwal — EDIT (ubah field) atau DELETE (hapus jadwal)
enum ChangeRequestType {
  EDIT
  DELETE
}

// Status workflow pengajuan
enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               Int           @id @default(autoincrement())
  nipp             String        @unique
  name             String
  email            String        @unique
  password         String
  role             Role          @default(STAFF)
  jabatan          String?
  unit_id          Int?
  unit             Unit?         @relation(fields: [unit_id], references: [id])
  account_status   AccountStatus @default(PENDING)

  auditLogs        AuditLog[]    @relation("UserAuditLogs")

  schedules        Schedule[]    @relation("UserSchedules")
  targetedSchedules Schedule[]   @relation("TargetUserSchedules")
  createdSchedules Schedule[]    @relation("CreatorSchedules")
  participantOf    ScheduleParticipant[]
  changeRequestsAsRequester ScheduleChangeRequest[] @relation("ChangeRequestRequester")
  changeRequestsAsReviewer  ScheduleChangeRequest[] @relation("ChangeRequestReviewer")

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Unit {
  id        Int      @id @default(autoincrement())
  unit_name String   @unique
  users     User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String   @db.Text
  userId    Int
  user      User     @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Guest {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  purpose   String?

  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Schedule {
  id             Int             @id @default(autoincrement())
  type           ScheduleType
  
  user_id        Int?
  user           User?           @relation("UserSchedules", fields: [user_id], references: [id])
  
  guest_id       Int?
  guest          Guest?          @relation(fields: [guest_id], references: [id])
  
  target_user_id Int?
  target_user    User?           @relation("TargetUserSchedules", fields: [target_user_id], references: [id])
  
  created_by     Int?
  creator        User?           @relation("CreatorSchedules", fields: [created_by], references: [id])
  
  start_time     DateTime
  end_time       DateTime
  status         ScheduleStatus   @default(PENDING)
  category       ScheduleCategory @default(PRIBADI)
  notes          String?          @db.Text
  responseNote   String?          @db.Text

  realizationStatus RealizationStatus @default(BELUM_DIISI)
  realizationNotes  String?           @db.Text

  // Penanda apakah jadwal "TIDAK_SESUAI" ini sudah pernah dijadwalkan ulang.
  // True kalau user pernah membuat jadwal baru dengan memilih referensi ini di
  // dropdown "Jadwalkan Ulang" pada Modal Tambah Jadwal. Dipakai utk meng-exclude
  // dari dropdown agar tidak terjadi duplikasi reschedule.
  hasBeenRescheduled Boolean @default(false)

  // Penanda untuk rangkaian jadwal rutin/berulang. Semua jadwal hasil duplikasi
  // dari satu form recurring akan share UUID yang sama. NULL = jadwal tunggal.
  recurrenceGroupId   String?
  // Frekuensi rangkaian: 'DAILY' | 'WEEKLY' | 'MONTHLY' — disimpan per row utk
  // memudahkan UI menampilkan label "Jadwal Rutin Mingguan/Bulanan/Harian".
  recurrenceFrequency String?

  participants   ScheduleParticipant[]
  changeRequests ScheduleChangeRequest[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([recurrenceGroupId])
}

// Pengajuan perubahan jadwal (EDIT atau DELETE) dari role bawahan.
// Atasan (SUPER_ADMIN/MANAJER/ASISTEN_MANAJER) bypass dan langsung eksekusi.
model ScheduleChangeRequest {
  id          Int                  @id @default(autoincrement())
  scheduleId  Int
  schedule    Schedule             @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  requesterId Int
  requester   User                 @relation("ChangeRequestRequester", fields: [requesterId], references: [id])

  type        ChangeRequestType
  status      ChangeRequestStatus  @default(PENDING)

  // Untuk EDIT: simpan nilai yang diajukan (NULL = field tidak diubah)
  proposedNotes      String?           @db.Text
  proposedStartTime  DateTime?
  proposedEndTime    DateTime?
  proposedCategory   ScheduleCategory?

  // Catatan/alasan dari pengaju
  requestNote String?              @db.Text
  // Catatan dari atasan saat approve/reject
  reviewNote  String?              @db.Text
  reviewerId  Int?
  reviewer    User?                @relation("ChangeRequestReviewer", fields: [reviewerId], references: [id])
  reviewedAt  DateTime?

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status])
  @@index([scheduleId])
  @@index([requesterId])
}

model ScheduleParticipant {
  id           Int            @id @default(autoincrement())
  scheduleId   Int
  userId       Int
  status       ScheduleStatus @default(PENDING)
  responseNote String?        @db.Text

  schedule     Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id])

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([scheduleId, userId])
  @@index([userId])
}
